# 复制为 .env 后按需修改。所有项均有代码默认值（见 back_end/src/memory/config.py）

# ===== 身份与隔离 =====
# MCP server 必须由 host 注入；不同 agent 用不同值实现数据隔离
MEMORY_NAMESPACE=agent-a

# ===== 存储 =====
# 默认 SQLite；要换 PG 改成 postgresql+psycopg://user:pass@host/db 并装驱动
DATABASE_URL=sqlite:///./data/memory.db
SQLITE_WAL=true
DB_BUSY_TIMEOUT_MS=5000
WEAVIATE_URL=http://127.0.0.1:8081
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ===== 模型供给 =====
EMBEDDING_BASE_URL=http://127.0.0.1:8082
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
LLM_BASE_URL=http://127.0.0.1:3000/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
RERANK_ENABLED=false
RERANK_BASE_URL=http://127.0.0.1:8083

# ===== 管理通道 =====
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8765
ADMIN_TOKEN=

# ===== 运维 =====
# 用户自行装 crontab；服务不内置调度器
GUIDE_CHECK_CRON=0 9 * * 1
