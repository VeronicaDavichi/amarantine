# 复制为 .env 后按需修改。所有项均有代码默认值（见 back_end/src/memory/config.py）

# ===== 身份与隔离 =====
# MCP server 必须由 host 注入；不同 agent 用不同值实现数据隔离
MEMORY_NAMESPACE=agent-a

# ===== 存储 =====
# 默认 SQLite；要换 PG 改成 postgresql+psycopg://user:pass@host/db 并装驱动
DATABASE_URL=sqlite:///./data/memory.db
# WAL 模式：缓解多 agent 并发写。**库级持久属性** ——
# 设 false 只对**新建**的库生效；已有库要显式 PRAGMA journal_mode=DELETE 才能退出。
SQLITE_WAL=true

# 抢不到写锁时最多等多久（毫秒），0 = 不等直接报 SQLITE_BUSY。
# 注意：这个值以前是假的 —— 11 个服务各自硬编码 timeout=5.0/10，
# 因为 5000 恰好等于 Python sqlite3 的默认 timeout，所以「看起来生效」。
# spec 024 已经统一到这一个来源。
DB_BUSY_TIMEOUT_MS=5000
WEAVIATE_URL=http://127.0.0.1:8081
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ===== 模型供给 =====
EMBEDDING_BASE_URL=http://127.0.0.1:8082
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# 远端 embedding 的 Bearer key（混合部署：低配机调高配机的 8082）。
# 为空时不发 header —— 本地服务不校验；配了就要求对端也配 --api-key。
EMBEDDING_API_KEY=
# 网关若只在 Windows 的 VPN 后面，WSL 直连必然超时（NAT 不继承 VPN 路由）。
# 这时在 Windows 上跑 harness/vpn_relay.py，这里留空即可 ——
# harness/dev-linux.sh 会自动填成 http://<WSL默认网关>:3000。
# 只有手动跑 python 时才需要在这里写死地址。
LLM_BASE_URL=
LLM_PROVIDER=anthropic
LLM_MODEL=deepseek-chat
LLM_API_KEY=
# 60s 对 30+30 条带上下文的切分太短（实测 20-80s），设 180s
LLM_TIMEOUT_MS=180000
# ===== 本地模型服务（harness/*_server.py 读这些；host/port 由 *_BASE_URL 决定）=====
# 与上面客户端同名不冲突：EMBEDDING_API_KEY 配一次，
# 服务端校验 + 客户端发送同时生效，不会一边配了另一边忘了。
EMBEDDING_PRELOAD=1
RERANK_PRELOAD=1

# ===== rerank（可选增强，默认关）=====
#
# 关掉时召回完全正常，只是排序退化成 RRF —— 这是设计好的降级路径，
# 不是功能缺失（A27）。所以**没有 reranker 也能一直用下去**。
#
# 想开：
#   bash harness/fetch-reranker.sh          # 下 bge-reranker-v2-m3（有 safetensors，免转换）
#   docker compose --profile rerank up -d reranker
#   RERANK_ENABLED=true                     # 然后重启后端
#
# 注意：不能拿 embedding 容器当 reranker —— TEI 只会用它 --model-id
# 加载的那一个模型做 rerank，bge-m3 会返回 424。
# 实测：CPU 上 rerank 约 0.3s，超时默认 800ms（原 300ms 会 ReadTimeout）
RERANK_ENABLED=false
RERANK_BASE_URL=http://127.0.0.1:8083
# 远端 rerank 的 Bearer key；为空不发 header（本地服务不校验）
RERANK_API_KEY=
# 模型名只用于请求体；实际打分的是容器里 --model-id 加载的那个
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 实体消歧（ADR C.B3 的 ② 级，spec 026）=====
# ADR 原方案是「实体名 embedding 余弦 >= 0.92」，实测证明该特征不可分：
#   应合并最低 0.4806（周会/每周例会）
#   不该合并最高 0.8801（项目A/项目A组）
# 区间完全重叠，任何单一阈值都同时误并和漏并。所以 ② 级改成确定性规则层。
#
# 总开关。关掉 = 回退到「只有 ③ LLM」的旧行为（单字名前缀判定仍然保留）。
ENTITY_RULE_ENABLED=true

# 后缀白名单：短名是长名前缀、且多出部分在此表内 -> 判同一实体。逗号分隔。
# ⚠️ 「组」故意不在默认值里：项目A/项目A组 是不同实体（余弦 0.8801 却该区分）。
# ⚠️ 显式写成空串 = 禁用这条规则（不是用默认值）。
ENTITY_SUFFIXES=AI,助手,公司,集团,科技,股份,有限公司,市,省,县,区,镇,部,处,科,院,局

# 称呼后缀：剥掉后相等 -> 判同一实体。逗号分隔；空串禁用。
# 剥完长度必须 >= 2，否则「王总 -> 王」这种单字名无法判定。
ENTITY_HONORIFICS=总,经理,老师,哥,姐,先生,女士,同学,工

# 同义词表：a=b,c=d 格式，双向生效；空串禁用。
# 周会/每周例会 这类字面不包含、余弦仅 0.4806，任何规则都判不出来，
# 只能靠词典 —— 这是承认规则能力边界的做法。
ENTITY_SYNONYMS=周会=每周例会,例会=每周例会,月会=每月例会,腾讯=Tencent,阿里=Alibaba

# ===== 打标与复核 =====
# 打标 LLM 的采样温度。低温度降漂移（ADR C.B10）：
# 同一句话两次打标结果要一致，否则双跑一致性校验天然偏低，看起来像模型不稳。
# 设成接近 0 的值（如 0.1~0.2）让打标结果稳定可复现。
LABEL_LLM_TEMP=0.2

# GET /admin/label-review 不传 limit 时返回多少条（周度复核批量）。
# 显式传 ?limit=N 时以参数为准。
LABEL_REVIEW_BATCH=50

# ===== 管理通道 =====
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8765
ADMIN_TOKEN=
# 读 token 的 header 名。默认 Authorization（按 Bearer <token> 解析）；
# 改成其它名字（如 X-Agent-Key）时，整个 header 值就是 token，不剥 Bearer。
AGENT_KEY_HEADER=Authorization

# ===== 运维 =====
# 用户自行装 crontab；服务不内置调度器
GUIDE_CHECK_CRON=0 9 * * 1

# 日志落盘，不走 stdout/stderr（MCP 的 std 只跑协议）
LOG_FILE=logs/memory.log
LOG_LEVEL=INFO

# ===== 召回：时间过滤器 =====
# 时间解析置信度低于该值时**不设 date filter**（退回全库），trace 里标 time_unresolved=true。
# 为什么「宁可不设」：时间过滤器是硬 AND，窗口设窄了，窗口外的正确材料就永远回不来。
# <=0 表示关闭这道闸门（沿用项目里「0 = 关信号」的约定）。
#
# 置信度是三档（spec 018）：
#   1.0  精确/明确：2026-11-04、今天、昨天、上周、上个月、去年
#   0.6  推算：上个月底、年底、去年底 —— 窗口宽度是代码里的常数，不是推导出来的
#   0.0  解析不出
#
# 默认 0.5 时推算档（0.6）**过线** —— 行为与分级前一致。
# 调到 0.7 就能把推算档单独挡掉（退回全库），保留精确档。这是这条配置的真实调节区间。
TIME_CONF_MIN=0.5

# ===== 召回：通道超时与预算 =====
# 两条通道各有自己的超时；整体预算再兜一层。
#
# VECTOR_TIMEOUT_MS 只作用于向量检索（Weaviate GraphQL）。
# 不作用于：list_all（管理接口全量列举）、写入路径、BM25 通道。
# BM25 没有独立配置项，由整体预算兜底 —— 数据量大时 BM25 本来就慢，
# 套 800ms 会误伤。
#
# <=0 表示不限（沿用项目里「0 = 关信号」的约定）。
# 注意：明确写 0 走 httpx 的「不限」，而不是「立即超时」。
VECTOR_TIMEOUT_MS=800
# 图通道超时（Neo4j 查询）。对齐的是 ADR C.B12 里 800ms 的**优化目标**。
GRAPH_TIMEOUT_MS=200
# 整体召回预算。所有通道并行 fan-out，超预算的通道标 partial。
# 这是**运行时保护**（别让用户干等），不是性能目标。
RECALL_BUDGET_MS=1500
# 冷查询 **SLA 护栏**：单次召回超过它就打 WARNING；写 0 或负数关闭告警。
# 注意它和 VECTOR_TIMEOUT_MS 不是一回事：后者是「一次 HTTP 等多久算异常」，
# 这里是「整次查询多久算不可接受」。实测 P95 约 671-878ms（spec 028），
# 离 3000 有 4 倍余量，所以它只在严重退化时才响。
COLD_QUERY_P95_MS=3000

# ===== 遗忘与保护（ADR D7 / A10 / A11）=====
#
# 淘汰条件**四个必须同时满足**：
#   ① 距上次召回 >= FORGET_IDLE_DAYS
#   ② 召回次数 < FORGET_MIN_RECALLS
#   ③ 创建超过 FORGET_GRACE_DAYS
#   ④ retention = normal
#
# 另外五类「硬信号」会绝对保护（不受上面条件影响）：
#   pinned / retention=permanent / 有 unresolved 事项 /
#   graph_degree >= GRAPH_HUB_DEGREE / confirmed_by_use >= CONFIRMED_MIN

# 遗忘扫描周期（天）。admin 服务常驻时，每满这个周期自动跑一次扫描。
#
# 扫描**只出报告，不删任何东西**（A12：误删率闸门未过前不允许自动删除）。
# 结果打到日志：`遗忘扫描 namespace=... 共N 保护a/复核b/可删c`。
# 要看完整明细（含抽样 event_id）调 POST /admin/forget/sweep。
#
# ⚠️ 进程重启会重扫一次（下次扫描时间存在内存里）。
FORGET_SWEEP_DAYS=30

# 距上次召回多久算「够久」（天）。调大 = 更保守，调小 = 更激进。
#
# ⚠️ **0 不是「关闭」**，是「立即淘汰」：`idle >= 0` 永远成立。
#    想关掉淘汰请把值调到很大（如 99999）。详见 ADR「配置值的关闭惯例」。
FORGET_IDLE_DAYS=180

# 新条目保护期（天）：创建不足此天数的卡不进任何删除桶，防「新条目饥饿」。
FORGET_GRACE_DAYS=90

# 召回次数低于此值视为「低召回」。注意是**严格小于**：
# 默认 1 表示「一次都没被召回」才算低召回，召回过一次就安全。
FORGET_MIN_RECALLS=1

# importance 灰区阈值：>= 此值进「人工复核」桶。
#
# ⚠️ **这不是自动豁免**（ADR 明确）：importance 是写入时 LLM 的自评，
#    不可靠，所以高了不自动保留，而是升级为人看一眼。
PROTECT_IMPORTANCE_REVIEW=0.7

# 有效引用次数达此值即受保护（第 5 类硬信号）。
CONFIRMED_MIN=2

# 图度数达此值视为枢纽节点，绝对保护（第 4 类硬信号）。
# 0 = 关闭这条信号（不是「所有卡 degree>=0 于是全被保护」）。
#
# 它与下面的孤岛判定**对称**：一个护枢纽，一个加速小簇。
GRAPH_HUB_DEGREE=8

# ===== 孤岛降权（spec 022）=====
# 「这两三个 node 形成孤立子图、和别的 node 没关系」→ 更快进入淘汰线。
# 只放宽「多久算久」的门槛，不新增删除路径，不绕过任何硬信号。
#
# 默认 0 = 关闭。**冷启动阶段不要开**：只有几条记忆时，每一条都是孤立的，
# 开了等于全员加速淘汰。建议 namespace 有 50+ 条真实记忆后再设 2。
ISLAND_MAX_NEIGHBORS=0
#
# 数据量门槛：namespace 事件数低于此值时不判孤岛。
ISLAND_MIN_EVENTS=50

# ===== 拼音缩写（spec 048）=====
# 是否允许调用 nbnhhsh 公开 API（lab.magiconch.com）猜缩写。
# 默认 false（依赖外网，VPN/公司网断开时会拖慢导入）。
# 关闭后仍会用 config/abbr_local.json 的本地词典，功能不消失。
ABBR_NBNHHHSH_ENABLED=false
