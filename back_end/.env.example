# 复制为 .env 后按需修改。所有项均有代码默认值（见 back_end/src/memory/config.py）

# ===== 身份与隔离 =====
# MCP server 必须由 host 注入；不同 agent 用不同值实现数据隔离
MEMORY_NAMESPACE=agent-a

# ===== 存储 =====
# 默认 SQLite；要换 PG 改成 postgresql+psycopg://user:pass@host/db 并装驱动
DATABASE_URL=sqlite:///./data/memory.db
SQLITE_WAL=true
DB_BUSY_TIMEOUT_MS=5000
WEAVIATE_URL=http://127.0.0.1:8081
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ===== 模型供给 =====
EMBEDDING_BASE_URL=http://127.0.0.1:8082
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# 网关若只在 Windows 的 VPN 后面，WSL 直连必然超时（NAT 不继承 VPN 路由）。
# 这时在 Windows 上跑 harness/vpn_relay.py，这里留空即可 ——
# harness/dev-linux.sh 会自动填成 http://<WSL默认网关>:3000。
# 只有手动跑 python 时才需要在这里写死地址。
LLM_BASE_URL=
LLM_PROVIDER=anthropic
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT_MS=60000
# ===== rerank（可选增强，默认关）=====
#
# 关掉时召回完全正常，只是排序退化成 RRF —— 这是设计好的降级路径，
# 不是功能缺失（A27）。所以**没有 reranker 也能一直用下去**。
#
# 想开：
#   bash harness/fetch-reranker.sh          # 下 bge-reranker-v2-m3（有 safetensors，免转换）
#   docker compose --profile rerank up -d reranker
#   RERANK_ENABLED=true                     # 然后重启后端
#
# 注意：不能拿 embedding 容器当 reranker —— TEI 只会用它 --model-id
# 加载的那一个模型做 rerank，bge-m3 会返回 424。
# 实测：CPU 上 rerank 约 0.3s，超时默认 800ms（原 300ms 会 ReadTimeout）
RERANK_ENABLED=false
RERANK_BASE_URL=http://127.0.0.1:8083
# 模型名只用于请求体；实际打分的是容器里 --model-id 加载的那个
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 管理通道 =====
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8765
ADMIN_TOKEN=
# 读 token 的 header 名。默认 Authorization（按 Bearer <token> 解析）；
# 改成其它名字（如 X-Agent-Key）时，整个 header 值就是 token，不剥 Bearer。
AGENT_KEY_HEADER=Authorization

# ===== 运维 =====
# 用户自行装 crontab；服务不内置调度器
GUIDE_CHECK_CRON=0 9 * * 1

# 日志落盘，不走 stdout/stderr（MCP 的 std 只跑协议）
LOG_FILE=logs/memory.log
LOG_LEVEL=INFO

# ===== 召回：时间过滤器 =====
# 时间解析置信度低于该值时**不设 date filter**（退回全库），trace 里标 time_unresolved=true。
# 为什么「宁可不设」：时间过滤器是硬 AND，窗口设窄了，窗口外的正确材料就永远回不来。
# <=0 表示关闭这道闸门（沿用项目里「0 = 关信号」的约定）。
#
# 注意：当前 time_resolver 的 confidence 只有 0.0 / 1.0（解析成功或失败），
# 所以默认 0.5 与旧行为等价。这条配置的价值在「未来给模糊表达加中间置信度时自动生效」。
TIME_CONF_MIN=0.5
